{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crosshair-native:pack:1",
  "$comment": "UTF-8 JSON, not ZIP. Runtime also enforces 100 MiB input/PNG bytes/decoded pixels, total items <=2000, valid unique IDs, all references resolved, static PNG <=16 MiB and <=2048x2048.",
  "type": "object",
  "required": [
    "manifest",
    "profile",
    "presets",
    "assets"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "format"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "format": {
          "const": "CrosshairNativePack"
        }
      }
    },
    "profile": {
      "$ref": "urn:crosshair-native:profile:1"
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1999,
      "items": {
        "$ref": "urn:crosshair-native:preset:1"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 1998,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pngBase64"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9-]+$"
          },
          "pngBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 25165824
          }
        }
      }
    }
  }
}
